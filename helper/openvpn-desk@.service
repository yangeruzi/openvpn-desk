[Unit]
Description=OpenVPN Desk tunnel for %i
Documentation=man:openvpn(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=openvpn-desk
RuntimeDirectoryMode=0755
ExecStart=/usr/sbin/openvpn --suppress-timestamps --config /etc/openvpn-desk/profiles/%i.conf --writepid /run/openvpn-desk/%i.pid --status /run/openvpn-desk/%i.status 10
ExecStopPost=/bin/rm -f /run/openvpn-desk/%i.pid /run/openvpn-desk/%i.status
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETGID CAP_SETUID CAP_DAC_OVERRIDE CAP_IPC_LOCK
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/openvpn-desk /run/openvpn-desk
Restart=no

[Install]
WantedBy=multi-user.target
