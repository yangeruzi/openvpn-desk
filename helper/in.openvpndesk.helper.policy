<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>

  <action id="in.openvpndesk.helper">
    <description>OpenVPN Desk privileged helper</description>
    <message>OpenVPN Desk access is allowed for local users</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">
      /usr/lib/openvpn-desk/helper.py
    </annotate>


    <annotate key="org.freedesktop.policykit.exec.allow_gui">
      true
    </annotate>
  </action>

</policyconfig>
